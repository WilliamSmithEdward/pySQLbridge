# The sdist ships the test suite, and a suite missing the fixtures it
# imports is worse than none: setuptools takes the test_*.py files on
# its own and leaves behind __init__.py, the helpers they import and
# the .sql captures they read.
graft tests
# tests/test_replay.py imports scripts/replay.py, so an sdist without
# them ships a suite that cannot start. They are the source anyway.
graft scripts
prune scripts/differential
# The scripts above read the examples and the spec, and the README links
# the docs, so an sdist without them ships commands that fail.
graft examples
graft docs
include pysqlbridge.spec
include LICENSE
include README.md
recursive-exclude tests __pycache__
global-exclude *.py[cod]
